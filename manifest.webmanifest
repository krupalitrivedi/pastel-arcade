{
  "name": "Pixel Party",
  "short_name": "Pixel Party",
  "description": "Find players nearby and play tiny pastel games together, no internet needed.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbeefa",
  "theme_color": "#ffb3d1",
  "icons": [
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "assets/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
